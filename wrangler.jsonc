{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tasto",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "ef9cbceacd8be6cff839033e54c0cb6b",
  // Eigene Unterdomain. Die alte Route endlab.de/tasto* bleibt und leitet dauerhaft dorthin um.
  "routes": [
    { "pattern": "tasto.endlab.de", "custom_domain": true },
    { "pattern": "endlab.de/tasto*", "zone_name": "endlab.de" }
  ],
  "workers_dev": false,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tasto",
      "database_id": "22c8a94f-b886-42a4-8511-0e0b808f3a6a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  // Staging: Jede Vorschau (Zweig/PR) nutzt die eigene D1 tasto-vorschau, nie die Live-Daten.
  // Migrationen dafür: wrangler.preview-migrations.jsonc (läuft in cf:preview).
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "tasto-vorschau",
        "database_id": "ee44c05e-18a4-4bb3-8f9f-45a2ad9e03f0"
      }
    ],
    "observability": { "enabled": true }
  }
}
